{
  "schema": "harbornavi.k3.multiVisionSmoke.v1",
  "durationSeconds": 1800,
  "intervalSeconds": 10,
  "beaconUrl": "http://127.0.0.1:4174",
  "outputDir": "/tmp/harbornavi-p1/4ch-mixed-simulation",
  "analyzerCommand": "/usr/lib/harboros-beacon/harbornavi_k3_yolov8_analyzer.py",
  "modelPath": "/data/vision-models/current/detection/yolov8n_192x320.q.onnx",
  "labelPath": "/data/vision-models/current/detection/label.txt",
  "provider": "cpu",
  "capture": {
    "mode": "persistent_ffmpeg",
    "maxFrameAgeMs": 2500,
    "decodeBackend": "ffmpeg_sw_persistent"
  },
  "cameras": [
    {
      "cameraId": "cam-real-231",
      "kind": "real",
      "sourceSecretRef": "env:CAM_REAL_231_RTSP"
    },
    {
      "cameraId": "cam-sim-1",
      "kind": "replay",
      "sourceSecretRef": "env:CAM_SIM_1_RTSP"
    },
    {
      "cameraId": "cam-sim-2",
      "kind": "replay",
      "sourceSecretRef": "env:CAM_SIM_2_RTSP"
    },
    {
      "cameraId": "cam-sim-3",
      "kind": "replay",
      "sourceSecretRef": "env:CAM_SIM_3_RTSP"
    }
  ]
}
