#!/bin/bash
set -euo pipefail

/usr/lib/harboros-beacon/validate-harborbeacon-service-auth
/usr/lib/harboros-beacon/ensure-harborbeacon-model-token

if ! getent group harborbeacon >/dev/null 2>&1; then
  addgroup --system harborbeacon
fi
if ! id harborbeacon >/dev/null 2>&1; then
  adduser --system --ingroup harborbeacon --home /var/lib/harboros-beacon --no-create-home harborbeacon
fi

append_env_if_missing() {
  local env_file="$1"
  local key="$2"
  local value="$3"
  if ! grep -q "^${key}=" "$env_file" 2>/dev/null; then
    printf '%s=%s\n' "$key" "$value" >> "$env_file"
  fi
}

upsert_env_value() {
  local env_file="$1"
  local key="$2"
  local value="$3"
  if grep -q "^${key}=" "$env_file" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$env_file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$env_file"
  fi
}

ensure_harborbeacon_runtime_env() {
  local env_file="/etc/default/harboros-beacon"
  local writable_root="/mnt/software/harborbeacon-agent-ci"
  local candle_root="${writable_root}/model-store/runtimes/harbor-candle"

  install -d -m 0755 /etc/default
  install -d -m 0755 "${candle_root}/cache"
  install -d -m 0755 "${candle_root}/bootstrap-llm"
  touch "$env_file"
  chmod 0600 "$env_file"

  append_env_if_missing "$env_file" "HARBOR_HARBOROS_WRITABLE_ROOT" "$writable_root"
  upsert_env_value "$env_file" "HARBOR_MODEL_API_BASE_URL" "http://127.0.0.1:4174/api/inference/v1"
  append_env_if_missing "$env_file" "HARBOR_MODEL_API_BACKEND" "candle"
  append_env_if_missing "$env_file" "HARBOR_MODEL_API_CHAT_MODEL" "Qwen/Qwen2.5-0.5B-Instruct"
  append_env_if_missing "$env_file" "HARBOR_MODEL_API_CANDLE_CHAT_MODEL_ID" "${candle_root}/bootstrap-llm"
  append_env_if_missing "$env_file" "HARBOR_MODEL_API_CANDLE_CACHE_DIR" "${candle_root}/cache"
  upsert_env_value "$env_file" "HARBOR_SEMANTIC_ROUTER_TOPOLOGY" "embedded"
  append_env_if_missing "$env_file" "HARBOR_SEMANTIC_ROUTER_LOCAL_ONLY" "1"
}

ensure_harborbeacon_runtime_env
install -d -o harborbeacon -g harborbeacon -m 0750 \
  /var/lib/harboros-beacon /mnt/software/harborbeacon-agent-ci
chown -R harborbeacon:harborbeacon \
  /var/lib/harboros-beacon /mnt/software/harborbeacon-agent-ci
/usr/lib/harboros-beacon/reconcile-legacy-semantic-router
systemctl daemon-reload
systemctl enable harboros-beacon.service
systemctl restart harboros-beacon.service

exit 0
