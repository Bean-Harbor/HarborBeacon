#!/bin/sh
set -e

if ! getent group harborbeacon >/dev/null 2>&1; then
  addgroup --system harborbeacon
fi
if ! id harborbeacon >/dev/null 2>&1; then
  adduser --system --ingroup harborbeacon --home /data/harborbeacon --no-create-home harborbeacon
fi

/usr/lib/harborbeacon/ensure-data-layout /data/harborbeacon

if command -v deb-systemd-helper >/dev/null 2>&1; then
  deb-systemd-helper unmask harboros-beacon.service >/dev/null || true
  deb-systemd-helper enable harboros-beacon.service >/dev/null || true
fi

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  systemctl try-restart harboros-beacon.service || true
fi

exit 0
