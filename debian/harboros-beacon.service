[Unit]
Description=HarborOS Beacon API Service
Wants=harborlink.target
After=network.target harborlink.target

[Service]
Type=simple
User=harborbeacon
Group=harborbeacon
Environment=HARBOR_FFMPEG_BIN=/usr/bin/ffmpeg
Environment=HARBOR_FFPROBE_BIN=/usr/bin/ffprobe
Environment=HARBORLINK_MEDIA_API_URL=http://127.0.0.1:8790
Environment=HARBORBEACON_SOUTHBOUND_MODE=harborlink
Environment=HARBOR_K3_CAT_AUTO_RECORD_ENABLED=true
Environment=HARBOR_K3_CAT_RECORDING_RECONCILIATION_PATH=/var/lib/harboros-beacon/cat-recording-reconciliation.json
Environment=HARBOR_K3_CAT_RECORDING_VALIDATION_MODE=enforce
Environment=HARBOR_K3_CAT_RECORDING_VALIDATION_STORE_PATH=/var/lib/harboros-beacon/cat-recording-validations.jsonl
Environment=HARBOR_K3_CAT_RECORDING_VALIDATION_TEMP_ROOT=/run/harboros-beacon/cat-recording-validation
Environment=HARBOR_K3_CAT_RECORDING_VALIDATOR=mobilenet_v2_int8
Environment=HARBOR_K3_CAT_RECORDING_CLASSIFIER_BIN=/usr/lib/harboros-beacon/harbornavi_k3_cat_recording_classifier.py
Environment=HARBOR_K3_CAT_RECORDING_CLASSIFIER_MODEL=/var/lib/harboros-beacon/vision-models/mobilenetv2-cat-binary-v2-20260806/mobilenetv2_cat_binary_int8.onnx
Environment=HARBOR_K3_CAT_RECORDING_CLASSIFIER_MODEL_SHA256=d0c1bdcf973ca7f6efc6e62af764ff59300e0d27abbc75c20c7f86515769d825
Environment=HARBOR_K3_CAT_RECORDING_CLASSIFIER_THRESHOLD=0.62
Environment=HARBOR_K3_CAT_RECORDING_CLASSIFIER_AI_THREADS=4
Environment="HARBOR_K3_CAT_RECORDING_CLASSIFIER_AFFINITY=12;13;14;15"
Environment=HARBOR_AI_RESOURCE_LEASE_QUEUE_CAPACITY=8
Environment=HARBOR_AI_RESOURCE_LEASE_WAIT_TIMEOUT_MS=60000
LoadCredential=harborlink-local-api-token:/etc/harborlink/local-api.token
Environment=HARBORLINK_LOCAL_API_TOKEN_FILE=%d/harborlink-local-api-token
Environment=HARBOR_VISION_EVENT_STORE_PATH=/var/lib/harboros-beacon/vision-events.jsonl
LoadCredential=gate-to-beacon-accept-current:/etc/harboros/service-auth/gate-to-beacon.accept-current
LoadCredential=gate-to-beacon-accept-previous:/etc/harboros/service-auth/gate-to-beacon.accept-previous
LoadCredential=beacon-to-gate-send:/etc/harboros/service-auth/beacon-to-gate.send
Environment=HARBOR_GATE_TO_BEACON_TOKEN_FILE=%d/gate-to-beacon-accept-current
Environment=HARBOR_GATE_TO_BEACON_TOKEN_PREVIOUS_FILE=%d/gate-to-beacon-accept-previous
Environment=HARBOR_BEACON_TO_GATE_TOKEN_FILE=%d/beacon-to-gate-send
EnvironmentFile=-/etc/default/harboros-beacon
ExecStart=/usr/bin/harboros-beacon --bind 127.0.0.1:4174 --admin-state /var/lib/harboros-beacon/admin-console.json --device-registry /var/lib/harboros-beacon/device-registry.json --conversations /var/lib/harboros-beacon/task-api-conversations.json --harbor-assistant-dist /usr/share/truenas/webui --public-origin http://127.0.0.1:4174
Restart=always
RestartSec=5s
MemoryAccounting=true
MemoryHigh=8G
MemoryMax=12G
RuntimeDirectory=harboros-beacon
StateDirectory=harboros-beacon

[Install]
WantedBy=multi-user.target
