[Unit]
Description=HarborOS K3 Local Model Runtime
Requires=harboros-bootstrap.service
After=local-fs.target harboros-bootstrap.service
RequiresMountsFor=/data

[Service]
Type=simple
User=harbormodel
Group=harbormodel
UMask=0077
Environment=HARBOR_MODEL_API_BIND=127.0.0.1:8792
Environment=HARBOR_MODEL_API_BACKEND=candle
Environment=HARBOR_MODEL_API_CHAT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
Environment=HARBOR_MODEL_API_CANDLE_CHAT_MODEL_ID=/data/models/current/semantic-router/qwen2.5-0.5b-instruct
Environment=HARBOR_MODEL_API_CANDLE_EMBEDDING_MODEL_ID=/data/models/current/embedding/jina-embeddings-v2-base-zh
Environment=HARBOR_MODEL_API_CANDLE_CACHE_DIR=/data/models/cache
Environment=HARBOR_MODEL_API_CANDLE_MAX_NEW_TOKENS=128
Environment=HARBOR_MODEL_API_CANDLE_TEMPERATURE=0.1
ExecStart=/usr/bin/harbor-model-api
Restart=on-failure
RestartSec=5s
MemoryAccounting=true
MemoryHigh=12G
MemoryMax=16G
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/models/cache
ReadOnlyPaths=/data/models/current

[Install]
WantedBy=multi-user.target
