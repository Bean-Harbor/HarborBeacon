[Unit]
Description=HarborOS K3 Local Model Runtime
Requires=harboros-bootstrap.service
After=local-fs.target harboros-bootstrap.service
RequiresMountsFor=/data

[Service]
Type=simple
User=harbormodel
Group=harbormodel
UMask=0077
EnvironmentFile=/etc/default/harboros-fixed-models
ExecStart=/usr/bin/harbor-model-api
ExecStartPost=/usr/lib/harboros-model-runtime/wait-health http://127.0.0.1:8792/healthz 60
TimeoutStartSec=75
TimeoutStopSec=15
KillMode=control-group
Restart=on-failure
RestartSec=5s
MemoryAccounting=true
MemoryHigh=12G
MemoryMax=16G
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/data/models

[Install]
WantedBy=multi-user.target
