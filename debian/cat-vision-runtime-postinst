#!/bin/sh
set -eu

release_root="/data/vision-models/releases/VERSION_PLACEHOLDER"
source_root="/usr/share/harboros-cat-vision-runtime/models"
manifest="/usr/share/harboros-cat-vision-runtime/cat-vision-materials.json"
evidence="/usr/share/doc/harboros-cat-vision-runtime/vision-runtime-evidence.json"
verify_release="/usr/lib/harboros-cat-vision-runtime/verify-release"
verify_evidence="/usr/lib/harboros-cat-vision-runtime/verify-evidence"
staging_root=""
backup_root=""
previous_current=""
had_current=0
current_state_captured=0
current_new_created=0
current_switched=0
release_installed=0
transaction_committed=0
generation_state_dir="/run/harboros-k3-generation"
beacon_active_state="$generation_state_dir/beacon-was-active"
beacon_state_tmp=""

validate_beacon_active_state() {
  [ ! -L "$beacon_active_state" ] \
    && [ -f "$beacon_active_state" ] \
    && [ "$(stat -c %u "$beacon_active_state")" = 0 ] \
    && [ "$(stat -c %a "$beacon_active_state")" = 600 ] \
    && [ "$(stat -c %s "$beacon_active_state")" = 24 ] \
    && [ "$(cat "$beacon_active_state")" = harboros-beacon.service ] || {
    echo "error: unsafe Beacon generation active state: $beacon_active_state" >&2
    exit 1
  }
}

stop_beacon_for_generation_change() {
  if [ -e "$generation_state_dir" ] || [ -L "$generation_state_dir" ]; then
    [ ! -L "$generation_state_dir" ] \
      && [ -d "$generation_state_dir" ] \
      && [ "$(stat -c %u "$generation_state_dir")" = 0 ] \
      && [ "$(stat -c %a "$generation_state_dir")" = 700 ] || {
      echo "error: unsafe Beacon generation state directory" >&2
      exit 1
    }
  else
    install -d -o root -g root -m 0700 "$generation_state_dir"
  fi
  if [ -e "$beacon_active_state" ] || [ -L "$beacon_active_state" ]; then
    validate_beacon_active_state
  elif systemctl is-active --quiet harboros-beacon.service; then
    beacon_state_tmp="$(mktemp "$generation_state_dir/.beacon-was-active.XXXXXXXX")"
    printf '%s\n' harboros-beacon.service > "$beacon_state_tmp"
    chown root:root "$beacon_state_tmp"
    chmod 0600 "$beacon_state_tmp"
    mv -f -- "$beacon_state_tmp" "$beacon_active_state"
    beacon_state_tmp=""
  fi
  systemctl stop harboros-beacon.service >/dev/null 2>&1 || true
  if systemctl is-active --quiet harboros-beacon.service; then
    echo "error: Beacon must stop before vision generation changes" >&2
    exit 1
  fi
}

cleanup() {
  if [ "$transaction_committed" -ne 1 ]; then
    if [ "$release_installed" -eq 1 ]; then
      rm -rf -- "$release_root"
    fi
    if [ -n "$backup_root" ] && [ -d "$backup_root" ]; then
      mv -- "$backup_root" "$release_root"
      backup_root=""
    fi
    if [ "$current_new_created" -eq 1 ]; then
      rm -f -- /data/vision-models/current.new
    fi
    if [ "$current_state_captured" -eq 1 ] && [ "$current_switched" -eq 1 ]; then
      if [ "$had_current" -eq 1 ]; then
        ln -s "$previous_current" /data/vision-models/current.new
        chown -h root:root /data/vision-models/current.new
        mv -Tf /data/vision-models/current.new /data/vision-models/current
      else
        rm -f -- /data/vision-models/current /data/vision-models/current.new
      fi
    fi
  elif [ -n "$backup_root" ] && [ -d "$backup_root" ]; then
    rm -rf -- "$backup_root"
  fi
  [ -z "$staging_root" ] || rm -rf -- "$staging_root"
  [ -z "$beacon_state_tmp" ] || rm -f -- "$beacon_state_tmp"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  stop_beacon_for_generation_change
fi

/usr/lib/harboros-cat-vision-runtime/ensure-data-layout /data/vision-models
if [ -e /data/vision-models/current.new ] || [ -L /data/vision-models/current.new ]; then
  echo "error: stale or unsafe /data/vision-models/current.new exists" >&2
  exit 1
fi
if [ -e /data/vision-models/current ] || [ -L /data/vision-models/current ]; then
  [ -L /data/vision-models/current ] || {
    echo "error: /data/vision-models/current is not a managed symlink" >&2
    exit 1
  }
  previous_current="$(readlink /data/vision-models/current)"
  case "$previous_current" in
    releases/*)
      previous_version="${previous_current#releases/}"
      case "$previous_version" in
        ""|*/*|.|..) echo "error: unsafe current vision target: $previous_current" >&2; exit 1 ;;
      esac
      ;;
    *) echo "error: unsafe current vision target: $previous_current" >&2; exit 1 ;;
  esac
  had_current=1
fi
current_state_captured=1

"$verify_release" --manifest "$manifest" --root "$source_root"
"$verify_evidence" \
  --architecture ARCH_PLACEHOLDER \
  --evidence "$evidence" \
  --model-root "$source_root" \
  --package-version VERSION_PLACEHOLDER
staging_root="$(mktemp -d "/data/vision-models/releases/.VERSION_PLACEHOLDER.install.XXXXXXXX")"
chown root:root "$staging_root"
chmod 0700 "$staging_root"
cp -a --no-dereference "$source_root/." "$staging_root/"
"$verify_release" --manifest "$manifest" --root "$staging_root"
"$verify_evidence" \
  --architecture ARCH_PLACEHOLDER \
  --evidence "$evidence" \
  --model-root "$staging_root" \
  --package-version VERSION_PLACEHOLDER
chown -R root:root "$staging_root"
find "$staging_root" -type d -exec chmod 0755 {} +
find "$staging_root" -type f -exec chmod 0444 {} +

if [ -L "$release_root" ] || { [ -e "$release_root" ] && [ ! -d "$release_root" ]; }; then
  echo "error: vision release target is not a real directory: $release_root" >&2
  exit 1
fi
if [ -d "$release_root" ]; then
  backup_root="$(mktemp -d "/data/vision-models/releases/.VERSION_PLACEHOLDER.previous.XXXXXXXX")"
  rmdir "$backup_root"
  mv -- "$release_root" "$backup_root"
fi
release_installed=1
mv -- "$staging_root" "$release_root"
staging_root=""
"$verify_release" --manifest "$manifest" --root "$release_root"
"$verify_evidence" \
  --architecture ARCH_PLACEHOLDER \
  --evidence "$evidence" \
  --model-root "$release_root" \
  --package-version VERSION_PLACEHOLDER

current_new_created=1
ln -s "releases/VERSION_PLACEHOLDER" /data/vision-models/current.new
chown -h root:root /data/vision-models/current.new
current_switched=1
mv -Tf /data/vision-models/current.new /data/vision-models/current
chown root:root /data/vision-models /data/vision-models/releases
chmod 0755 /data/vision-models /data/vision-models/releases

transaction_committed=1
if [ -n "$backup_root" ]; then
  rm -rf -- "$backup_root"
  backup_root=""
fi
trap - EXIT HUP INT TERM
exit 0
