[Unit]
Description=HarborOS K3 Event VLM Runtime
Requires=harboros-bootstrap.service
After=local-fs.target harboros-bootstrap.service
RequiresMountsFor=/data

[Service]
Type=simple
User=harbormodel
Group=harbormodel
UMask=0077
Environment=OMP_NUM_THREADS=8
ExecStart=/usr/bin/llama-server -m /data/models/current/vlm/Qwen3.5-0.8B/qwen3_5vl_0.8b-text-q41.gguf --vision-backend smt --smt-config-dir /data/models/current/vlm/Qwen3.5-0.8B -ngl 0 --ctx-size 4096 -t 8 -tb 8 --host 127.0.0.1 --port 8080 --no-warmup --reasoning off
Restart=on-failure
RestartSec=5s
MemoryAccounting=true
MemoryHigh=12G
MemoryMax=16G
LimitNOFILE=1048576
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/data/models/current

[Install]
WantedBy=multi-user.target
